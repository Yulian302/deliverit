# Gateway local config. Copy to .env (git-ignored) and edit:
#   cp services/gateway/.env.example services/gateway/.env
# `make run-gateway` creates it for you if it's missing.
#
# Format: KEY=value, one per line, no spaces around "=". The file is read
# by the shell (Makefile) and by docker compose (env_file), so keep it simple.
# The binary itself never reads this file: in containers the platform sets
# real environment variables.

SERVICE_NAME=gateway
# debug | info | warn | error
LOG_LEVEL=debug
HTTP_ADDR=:8080
# Order service base URL (`make run-order` listens on :8081).
ORDER_URL=http://localhost:8081
# OTLP gRPC collector, e.g. localhost:4317 with otel-lgtm running. Empty = no export.
OTEL_EXPORTER_OTLP_ENDPOINT=
SHUTDOWN_GRACE=20s
