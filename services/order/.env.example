# Order local config. Copy to .env (git-ignored) and edit:
#   cp services/order/.env.example services/order/.env
# `make run-order` / `make migrate` create it for you if it's missing.
#
# Format: KEY=value, one per line, no spaces around "=". The file is read
# by the shell (Makefile) and by docker compose (env_file), so keep it simple.
# The binary itself never reads this file: in containers the platform sets
# real environment variables.

SERVICE_NAME=order
# debug | info | warn | error
LOG_LEVEL=debug
HTTP_ADDR=:8081
# Matches `make db-up`. Local throwaway credentials only; real ones never go in a file.
DATABASE_URL=postgres://deliverit:deliverit@localhost:5432/deliverit?sslmode=disable
# OTLP gRPC collector, e.g. localhost:4317 with otel-lgtm running. Empty = no export.
OTEL_EXPORTER_OTLP_ENDPOINT=
SHUTDOWN_GRACE=20s
# How long `order migrate` waits for Postgres to accept connections.
MIGRATE_WAIT=60s
